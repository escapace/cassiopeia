{
  "name": "@cassiopeia/vue",
  "description": "Vue integration for Cassiopeia that registers triple-dash custom properties as components are added and removed.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/cassiopeia/issues",
  "devDependencies": {
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-escapace": "5.20.3",
    "esroll": "1.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^11.20.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^24.16.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      },
      "browser": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/browser/index.js"
        }
      },
      "default": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      }
    }
  },
  "files": [
    "lib/browser",
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/cassiopeia/tree/trunk/packages/vue#readme",
  "license": "MPL-2.0",
  "peerDependencies": {
    "cassiopeia": "workspace:*",
    "vue": "^3.5.41"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/cassiopeia",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format --source package.json && eslint --no-warn-ignored --fix && prettier --log-level warn --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "test": "vitest --no-watch --coverage --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run -w syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
