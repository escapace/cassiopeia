{
  "name": "cassiopeia",
  "description": "Runtime CSS system that uses triple-dash custom properties to generate styles as application state changes, users update preferences, and components are added and removed.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/cassiopeia/issues",
  "devDependencies": {
    "@escapace/syncpack-configuration": "0.1.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@thi.ng/random": "4.1.43",
    "@types/node": "25.5.2",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "9.39.4",
    "eslint-config-escapace": "5.16.0",
    "esroll": "1.2.0",
    "jsdom": "29.0.1",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.3.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.33.0"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      },
      "browser": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/browser/index.js"
        }
      },
      "default": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      }
    }
  },
  "files": [
    "lib/browser",
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/cassiopeia/tree/trunk/packages/cassiopeia#readme",
  "license": "MPL-2.0",
  "peerDependencies": {
    "@escapace/fsm": "^6.1.0",
    "@escapace/typelevel": "^2.0.3",
    "coastal": "^0.4.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/cassiopeia",
  "scripts": {
    "bench": "pnpm exec vitest bench --project browser --run",
    "build": "tsx scripts/build.ts",
    "format": "syncpack format --source package.json && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run -w syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
