{
  "builds": {
    "browser": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"browser\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "browser", "main"],
      "outdir": "lib/browser",
      "platform": "browser",
      "target": ["chrome132", "firefox132", "edge131", "opera113", "safari18.2"]
    },
    "node": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"node\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "main"],
      "outdir": "lib/node",
      "platform": "node",
      "target": ["node22.13.1"]
    }
  }
}
