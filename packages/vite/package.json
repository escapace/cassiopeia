{
  "name": "@cassiopeia/vite",
  "description": "Vite integration for Cassiopeia that detects triple-dash custom properties in Vue single-file components and wires them into runtime style generation.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/cassiopeia/issues",
  "dependencies": {
    "@ast-grep/napi": "^0.42.1",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@escapace/syncpack-configuration": "0.2.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "25.5.2",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "10.2.0",
    "eslint-config-escapace": "5.17.0",
    "esroll": "1.2.1",
    "prettier": "3.8.3",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.3.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.33.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/cassiopeia/tree/trunk/packages/vite#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "cassiopeia": "workspace:*",
    "vite": "^8.0.8",
    "vue": "^3.5.32"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/cassiopeia",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format --source package.json && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run -w syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
