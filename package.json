{
  "name": "@cassiopeia/monorepo",
  "description": "Monorepo for Cassiopeia and its Vue and Vite integrations.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/cassiopeia/issues",
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@escapace/pnpm-pack": "0.8.0",
    "@escapace/syncpack-configuration": "0.1.1",
    "@ls-lint/ls-lint": "2.3.1",
    "eslint": "10.2.0",
    "eslint-config-escapace": "5.16.1",
    "knip": "6.4.1",
    "lefthook": "2.1.5",
    "prettier": "3.8.3",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.3.0"
  },
  "engines": {
    "pnpm": ">=10.33.0"
  },
  "files": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "homepage": "https://github.com/escapace/cassiopeia#readme",
  "license": "MPL-2.0",
  "private": true,
  "repository": "escapace/cassiopeia",
  "scripts": {
    "build": "pnpm run workspace:build",
    "format": "syncpack format --source package.json && eslint --ignore-pattern packages --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw !packages . && pnpm run workspace:format",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint --ignore-pattern packages && pnpm run workspace:lint",
    "ls-lint": "ls-lint --config .ls-lint.yaml && pnpm run workspace:ls-lint",
    "pack": "pnpm-pack workspace",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "pnpm run workspace:test",
    "typecheck": "pnpm run workspace:typecheck",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack",
    "workspace:build": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' build",
    "workspace:format": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' format",
    "workspace:lint": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' lint",
    "workspace:ls-lint": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' ls-lint",
    "workspace:test": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' test",
    "workspace:typecheck": "pnpm run --if-present --workspace-concurrency=4 -r --filter !. --filter '*' typecheck",
    "workspace:update": "pnpm -rw --filter !. --filter '*' --workspace-concurrency=4 exec ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module"
}
